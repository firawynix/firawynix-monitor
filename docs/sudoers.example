# /etc/sudoers.d/firawynix-monitor
#
# Instale SEMPRE com o visudo (valida a sintaxe antes de salvar):
#   sudo visudo -f /etc/sudoers.d/firawynix-monitor
#
# Confirme os caminhos absolutos no servidor e ajuste abaixo:
#   command -v systemctl docker podman kubectl k3s virsh ss kill incus lxc \
#              sshd ufw iptables nft fail2ban-client smartctl
#
# O Firawynix Monitor executa EXATAMENTE estes comandos, sempre com "sudo -n"
# (não interativo: se o sudoers exigir senha, a ação falha na hora e a
# interface explica o motivo — o monitor nunca envia senha ao sudo). Só é
# necessário liberar os que você habilitar no servers.json:
#
#   use_sudo      systemctl --no-block start|stop|restart <unidade>
#   logs_sudo     journalctl -u <unidade> -n <N> --no-pager
#   docker_sudo   docker ps -a --format ... | docker stats --no-stream --format ...
#                 docker start|stop -t 3|restart -t 3 <contêiner> [<contêiner>...]
#                 docker logs --tail <N> --timestamps <contêiner>
#   podman_sudo   os mesmos comandos acima com "podman" (ps usa "--format json")
#   kubectl_sudo  kubectl get pods -A ... | kubectl delete pod -n <ns> <pod> ...
#                 kubectl logs -n <ns> <pod> ...   (ou "k3s kubectl ...")
#   libvirt_sudo  virsh -c <uri> -q list --all | start|shutdown|reboot|dominfo <vm>
#   network_sudo  ss -tulnp            (mostra o processo dono de cada porta)
#   process_sudo  kill -TERM|-KILL <pid>
#   lxd_sudo      incus|lxc list --format json | start|stop|restart <instância>
#                 incus|lxc info --show-log <instância>
#   security_sudo sshd -T | ufw status verbose | iptables -S INPUT | nft list ruleset
#                 fail2ban-client status | fail2ban-client status <jail>
#   security_actions (exige security_sudo)
#                 fail2ban-client set <jail> banip|unbanip <ip>
#   smart_sudo    smartctl -j -H -A -i -d <tipo> <dispositivo>
#
# O usuário "monitor" é apenas um exemplo: use o mesmo "username" do servers.json.

# ---------------------------------------------------------------------------
# systemd — Opção A (recomendada): somente os serviços que podem ser controlados.
# ---------------------------------------------------------------------------
Cmnd_Alias FWX_NGINX = /usr/bin/systemctl --no-block start nginx.service, \
                       /usr/bin/systemctl --no-block stop nginx.service, \
                       /usr/bin/systemctl --no-block restart nginx.service

Cmnd_Alias FWX_APP   = /usr/bin/systemctl --no-block restart gunicorn.service, \
                       /usr/bin/systemctl --no-block restart celery-worker.service

monitor ALL=(root) NOPASSWD: FWX_NGINX, FWX_APP

# ---------------------------------------------------------------------------
# systemd — Opção B: qualquer unidade (mais simples, menos restritiva).
# Atenção: no sudoers o "*" casa com qualquer texto, inclusive argumentos
# extras. O monitor valida o nome antes de executar, mas a regra também vale
# para quem usar a mesma conta via SSH manualmente.
# ---------------------------------------------------------------------------
# Cmnd_Alias FWX_ANY = /usr/bin/systemctl --no-block start *, \
#                      /usr/bin/systemctl --no-block stop *, \
#                      /usr/bin/systemctl --no-block restart *
# monitor ALL=(root) NOPASSWD: FWX_ANY

# ---------------------------------------------------------------------------
# Portas com o processo dono (network_sudo: true) — somente leitura.
# ---------------------------------------------------------------------------
# monitor ALL=(root) NOPASSWD: /usr/bin/ss -tulnp

# ---------------------------------------------------------------------------
# k3s (kubectl_command: "k3s kubectl", kubectl_sudo: true). O kubeconfig do
# k3s (/etc/rancher/k3s/k3s.yaml) só é legível pelo root.
# ---------------------------------------------------------------------------
# Cmnd_Alias FWX_K3S = /usr/local/bin/k3s kubectl get pods *, \
#                      /usr/local/bin/k3s kubectl delete pod *, \
#                      /usr/local/bin/k3s kubectl logs *
# monitor ALL=(root) NOPASSWD: FWX_K3S

# ---------------------------------------------------------------------------
# libvirt: prefira o grupo "libvirt" (sudo usermod -aG libvirt monitor).
# Com libvirt_sudo: true, libere apenas as VMs desejadas:
# ---------------------------------------------------------------------------
# Cmnd_Alias FWX_VM = /usr/bin/virsh -c qemu\:///system -q list --all, \
#                     /usr/bin/virsh -c qemu\:///system start ci-runner, \
#                     /usr/bin/virsh -c qemu\:///system shutdown ci-runner, \
#                     /usr/bin/virsh -c qemu\:///system reboot ci-runner
# monitor ALL=(root) NOPASSWD: FWX_VM

# ---------------------------------------------------------------------------
# Auditoria de segurança (security_sudo: true) — somente leitura. Sem ela a
# auditoria continua funcionando, mas não lê a configuração efetiva do sshd em
# RHEL (sshd_config 0600), as regras de iptables/nftables nem o fail2ban.
# ---------------------------------------------------------------------------
# Cmnd_Alias FWX_AUDIT = /usr/sbin/sshd -T, /usr/sbin/ufw status verbose, \
#                        /usr/sbin/iptables -S INPUT, /usr/sbin/nft list ruleset, \
#                        /usr/bin/fail2ban-client status, /usr/bin/fail2ban-client status *
# monitor ALL=(root) NOPASSWD: FWX_AUDIT

# ---------------------------------------------------------------------------
# Banir/desbanir IPs pela interface (security_actions: true). Libere só as jails
# desejadas. O monitor recusa banir o próprio IP (evita se trancar para fora).
# ---------------------------------------------------------------------------
# Cmnd_Alias FWX_F2B = /usr/bin/fail2ban-client set sshd banip *, \
#                      /usr/bin/fail2ban-client set sshd unbanip *
# monitor ALL=(root) NOPASSWD: FWX_F2B

# ---------------------------------------------------------------------------
# SMART (smart_sudo: true). Opção A (recomendada): discos exatos, como aparecem
# em "smartctl --scan" ("scsi" vira "auto"):
# ---------------------------------------------------------------------------
# Cmnd_Alias FWX_SMART = /usr/sbin/smartctl -j -H -A -i -d auto /dev/sda, \
#                        /usr/sbin/smartctl -j -H -A -i -d nvme /dev/nvme0
# monitor ALL=(root) NOPASSWD: FWX_SMART
# Opção B (qualquer disco). Atenção: o "*" também casaria opções extras
# (ex.: "-s off"), por isso prefira a opção A em servidores críticos.
# monitor ALL=(root) NOPASSWD: /usr/sbin/smartctl -j -H -A -i -d * /dev/*

# ---------------------------------------------------------------------------
# LXD/Incus: prefira o grupo (sudo usermod -aG incus-admin monitor, ou lxd).
# Com lxd_sudo: true:
# ---------------------------------------------------------------------------
# Cmnd_Alias FWX_LXD = /usr/bin/incus list --format json, /usr/bin/incus info --show-log *, \
#                      /usr/bin/incus start *, /usr/bin/incus stop *, /usr/bin/incus restart *
# monitor ALL=(root) NOPASSWD: FWX_LXD

# ---------------------------------------------------------------------------
# NÃO recomendado: "kill" via sudo equivale a poder encerrar qualquer processo
# (inclusive o sshd). Sem process_sudo, o monitor só encerra processos do
# próprio usuário SSH — o que costuma bastar para workers e scripts.
# ---------------------------------------------------------------------------
# monitor ALL=(root) NOPASSWD: /usr/bin/kill -TERM *

# ---------------------------------------------------------------------------
# Sem sudo (preferível):
#   sudo usermod -aG systemd-journal monitor   # logs e eventos de todos os serviços
#   sudo usermod -aG docker monitor            # ATENÇÃO: grupo docker ≈ acesso root
#   sudo usermod -aG libvirt monitor           # listar/controlar VMs
#   sudo usermod -aG incus-admin monitor       # Incus (ou "lxd" no LXD) — também ≈ root
# ---------------------------------------------------------------------------
