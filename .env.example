# Copie para .env (mesma pasta do servers.json ou do executável).
# O .env é opcional: as mesmas variáveis podem ser definidas no Windows
# (Configurações > Sistema > Sobre > Configurações avançadas > Variáveis de Ambiente).
# Nunca versione o arquivo .env.
#
# Alternativa mais segura no Windows: guardar a senha/passphrase no Gerenciador de
# Credenciais (criptografada pelo Windows) com "password_credential": true no
# servers.json e o botão "Windows ⚙" > Credenciais, ou no PowerShell:
#   cmdkey /generic:FirawynixMonitor/staging /user:deploy /pass

# Passphrase da chave privada usada em "prod-web-01" (key_passphrase_env)
PROD_WEB_KEY_PASSPHRASE=

# Senha SSH de um servidor configurado com "password_env": "OUTRO_SSH_PASSWORD"
OUTRO_SSH_PASSWORD=
